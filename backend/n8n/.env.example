# N8N Environment Configuration
# Copy this file to .env and fill in your values

# Basic Auth
N8N_PASSWORD=your_secure_password_here

# Host Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=https

# Database (optional - uses SQLite by default)
# N8N_DATABASE_TYPE=postgresdb
# N8N_DATABASE_POSTGRESDB_HOST=localhost
# N8N_DATABASE_POSTGRESDB_PORT=5432
# N8N_DATABASE_POSTGRESDB_DATABASE=n8n
# N8N_DATABASE_POSTGRESDB_USER=n8n
# N8N_DATABASE_POSTGRESDB_PASSWORD=your_db_password

# Email Configuration (for error reporting)
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your_email@gmail.com
# N8N_SMTP_PASS=your_app_password

# Timezone
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# Execution Settings
EXECUTIONS_PROCESS=main
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_DATA_SAVE=true
